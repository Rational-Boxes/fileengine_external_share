# share_service — copy to .env and adjust. Never commit .env.
#
# Shared cross-service knobs use FILEENGINE_*; service-private ones use SHARE_*.

# --- gRPC core (delegated calls run as the link creator) ---
FILEENGINE_GRPC_HOST=localhost
FILEENGINE_GRPC_PORT=50051

# --- LDAP: creator role resolution + the share_external group ---
FILEENGINE_LDAP_ENDPOINT=ldap://localhost:1389
FILEENGINE_LDAP_DOMAIN=dc=rationalboxes,dc=com
FILEENGINE_LDAP_USER_BASE=ou=users,dc=rationalboxes,dc=com
FILEENGINE_LDAP_TENANT_BASE=ou=tenants,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_DN=cn=admin,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_PASSWORD=admin

# --- Bearer verification: the same secret http_bridge signs sessions with ---
FILEENGINE_JWT_SECRET=
FILEENGINE_JWT_ISSUER=fileengine-bridge

# --- Recipient OTP: ldap_manager owns the code, this service owns the allowlist
FILEENGINE_LDAP_MANAGER_URL=http://localhost:8093
SHARE_INTERNAL_SECRET=
SHARE_OTP_TIMEOUT_S=5

# --- Audit: a HARD dependency here, not an optional feature.
# The core attributes delegated activity to the creator, so this chain is the
# only record that an access was external (spec §4.3). Off => sharing off.
FILEENGINE_AUDIT_ENABLED=true
FILEENGINE_REDIS_HOST=localhost
FILEENGINE_REDIS_PORT=6379
FILEENGINE_REDIS_PASSWORD=
FILEENGINE_REDIS_DB=0
FILEENGINE_AUDIT_STREAM=fileengine:audit

# --- Creator notifications (spec §10.6) ---
# Share events are published onto the stream discussion's consumer already
# reads, so no new transport. Unlike audit these are a COURTESY: publishing
# failures are logged and swallowed, since a missed Dashboard item must never
# fail a redemption. That also means a wrong password here loses notifications
# quietly — check the log for "could not publish share.*" if the feed is empty.
FILEENGINE_EVENTS_STREAM=fileengine:events
# Which events raise a creator attention item. Decided HERE and nowhere else:
# the consumer raises whatever arrives. budget_exhausted and expiry_soon are
# available and off by default — they are the two most likely to become noise.
SHARE_ATTENTION_EVENTS=drop_received,otp_send_failed,link_dead,first_redemption

# --- This service's own Postgres ---
SHARE_PG_HOST=localhost
SHARE_PG_PORT=5434
SHARE_PG_DATABASE=share_service
SHARE_PG_USER=fileengine_user
SHARE_PG_PASSWORD=fileengine_password

# --- Surface. Monitoring is unauthenticated: keep it on loopback. ---
SHARE_API_HOST=0.0.0.0
SHARE_API_PORT=8101
SHARE_MONITORING_HOST=127.0.0.1
SHARE_MONITORING_PORT=8102

# --- Feature switches. An unauthenticated door is opt-in. ---
# OFF by default and it must stay that way in every shipped default: enabling
# this creates the only surface in the platform reachable without an account.
# A deployment gets it by deciding to, never by upgrading into it.
SHARE_ENABLED=false
SHARE_LDAP_GROUP=share_external
# Roles stripped before any delegated call. The core trusts what it is handed
# and system_admin bypasses every ACL check, so this is the only thing between
# an admin's bypass and a public URL (spec §6.3).
SHARE_ADMIN_ROLES=system_admin,tenant_admin,administrators

SHARE_MAX_TTL_DAYS=30
SHARE_SESSION_TTL_SECONDS=3600
SHARE_DEFAULT_TTL_DAYS=7
SHARE_MAX_USES_CAP=100
SHARE_MAX_RECIPIENTS=20
SHARE_UPLOAD_MAX_FILES=20
SHARE_ZIP_MAX_MEMBERS=5000
# Dead links are KEPT as audit evidence and purged after this window. The
# window exists chiefly for the recipient addresses (§5.4): people outside the
# organisation who never asked to be in this database. 0 disables the purge.
#
# Nothing about correctness depends on the sweep — every check is evaluated at
# redemption time — so a stalled sweep costs disk and PII retention, never
# enforcement.
SHARE_RETENTION_DAYS=365
SHARE_RETENTION_INTERVAL_S=21600
# Which tenants to sweep, comma-separated. Empty = the default tenant only.
# Named rather than discovered: a schema exists here as soon as a tenant is
# touched, which is not the same set as "tenants that should be swept".
SHARE_RETENTION_TENANTS=

# --- abuse escalation, rung 2 (spec §8.4) ---
# Rung 1 caps attempts PER ADDRESS and lives in ldap_manager, which owns the
# code. It is sidestepped by varying the address, so the link keeps its own
# rolling budget. Trips on either enough total failures, or enough DISTINCT
# addresses each having hit rung 1 — the spread pattern rung 1 cannot see.
#
# The result is a LOCK, not a revoke: it expires on its own, because revoking
# would punish the creator permanently for someone else's behaviour and the URL
# cannot be re-issued to people already holding it.
SHARE_LINK_LOCKOUT_THRESHOLD=15
SHARE_LINK_LOCKOUT_DISTINCT=3
SHARE_LOCKOUT_WINDOW_MINUTES=60
SHARE_LOCKOUT_MINUTES=15

# The origin the /s/ landing page is served from — it goes into the URL the
# creator copies and emails, so getting it wrong is discovered by the RECIPIENT.
#
# Empty falls back to this request's own origin, which is correct behind the
# unified nginx (it serves the SPA and proxies /share on one origin) and WRONG
# when the API is reached directly on :8101, since this service does not serve
# /s/ itself. Set it in dev; set it also to move share traffic to a separate
# download host later without invalidating links already sent (spec §8.3).
SHARE_PUBLIC_BASE_URL=
